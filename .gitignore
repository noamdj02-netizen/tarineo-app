# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.next-dev*/
/.next-build-test/
/out/

# local scratch / capture tooling (never ship)
/.tmp/
/recordly/
.impeccable/
/NullMotion/

# Finder / iCloud duplicate copies (« file 2.ext » / « file 2 »)
**/* 2.*
**/* 2

# production
/build

# misc
.DS_Store
.figma-capture-id

# Cursor agent skills (local only; install via scripts/install-claude-blog.sh)
.cursor/skills/

# claude-blog upstream (clone via scripts/install-claude-blog.sh)
/vendor/claude-blog/

# Local media archives (not product assets)
tarineo-remotion-medias.zip
tarineo-remotion-bundle.zip
/navpit/
/my-video/
.agents/
skills-lock.json
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local agent / IDE secrets
.codex/

# supabase cli
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
