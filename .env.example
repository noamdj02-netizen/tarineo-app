# Copie ce fichier en .env.local puis remplis les valeurs. Ne commit jamais .env.local.

# URL publique (prod : https://app.tarineo.com). Canonical, emails, OAuth.
NEXT_PUBLIC_APP_URL=https://app.tarineo.com

# SEO : Search Console → balise HTML → colle la valeur (sans guillemets)
# GOOGLE_SITE_VERIFICATION=

# Analytics — GTM-5NDNZWKQ est dans le layout (Consent Mode : tags après « Tout accepter »).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PageSpeed Insights (optionnel) : quota plus large pour scorer les sites des projets
# GOOGLE_PSI_API_KEY=

# Clés SECRÈTES : jamais de préfixe NEXT_PUBLIC_ (Anthropic, Stripe, service role, Resend).

# logo.dev — clé publique pk_… (logos ressources + bandeau landing)
# NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Mentions légales : région d’hébergement des données (ex. eu-west-3 — Paris)
# LEGAL_SUPABASE_DATA_REGION=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : seulement pour le script de seed, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Accès libre sans connexion : l'app utilise le compte SEED_USER_EMAIL.
# Pratique en dev. Mettre false avant d'ouvrir l'app au public.
NAVPIT_OPEN_ACCESS=false

# Ton email : le script de seed crée ton compte avec
SEED_USER_FIRST_NAME=
SEED_USER_EMAIL=

# Claude (console.anthropic.com → API Keys). Secret, côté serveur uniquement.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ton compte (ou plusieurs, séparés par des virgules) : jamais limité par les plans.
# Vide : SEED_USER_EMAIL est utilisé.
NAVPIT_OWNER_EMAILS=

# Stripe (dashboard.stripe.com → Développeurs → Clés API). Secret, côté serveur.
# sk_test_… en local, sk_live_… en production. Puis : npm run stripe:setup
# Les users lient LEUR Stripe depuis /outils avec une clé restreinte (jamais stockée).
STRIPE_SECRET_KEY=
# Secret du endpoint https://app.tarineo.com/api/billing/webhook (affiché une fois par stripe:setup)
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com → API Keys). Secret, côté serveur.
RESEND_API_KEY=
EMAIL_FROM=TARINEO <contact@tarineo.fr>

# Cron relances : GET /api/cron/follow-ups avec Authorization: Bearer …
# Sur Vercel, le même nom CRON_SECRET est injecté automatiquement dans les jobs cron.
CRON_SECRET=

# Web Push (optionnel). Générer : npx web-push generate-vapid-keys
# Sans ces clés, les notifications in-app fonctionnent ; le push navigateur reste désactivé.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@tarineo.fr

# Webhook Stripe alternatif (Edge Function Supabase, optionnel)
# supabase secrets set STRIPE_SECRET_KEY=… STRIPE_WEBHOOK_SECRET=… RESEND_API_KEY=… EMAIL_FROM="TARINEO <contact@tarineo.fr>" APP_URL=https://app.tarineo.com
