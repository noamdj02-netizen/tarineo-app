# Copie ce fichier en .env.local puis remplis les valeurs. Ne commit jamais .env.local.

# URL publique (prod : https://www.navpit.com). Utilisée pour SEO, emails Stripe, etc.
NEXT_PUBLIC_APP_URL=https://www.navpit.com

# SEO : Search Console → balise HTML → colle la valeur (sans guillemets)
# GOOGLE_SITE_VERIFICATION=

# Analytics (optionnel) : GA4 → ID de mesure G-XXXXXXXX — chargé seulement après consentement cookies
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Clés SECRÈTES : jamais de préfixe NEXT_PUBLIC_ (Anthropic, Stripe, service role, Resend).

# logo.dev — clé publique pk_… (logos ressources + bandeau landing)
# NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : seulement pour le script de seed, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Accès libre sans connexion : l'app utilise le compte SEED_USER_EMAIL.
# Pratique en dev. Mettre false avant d'ouvrir l'app au public.
NAVPIT_OPEN_ACCESS=false

# Ton email : le script de seed crée ton compte avec
SEED_USER_FIRST_NAME=
SEED_USER_EMAIL=

# Claude (console.anthropic.com → API Keys). Secret, côté serveur uniquement.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ton compte (ou plusieurs, séparés par des virgules) : jamais limité par les plans.
# Vide : SEED_USER_EMAIL est utilisé.
NAVPIT_OWNER_EMAILS=

# Stripe (dashboard.stripe.com → Développeurs → Clés API). Secret, côté serveur.
# sk_test_… en local, sk_live_… en production. Puis : npm run stripe:setup
STRIPE_SECRET_KEY=
# Secret du endpoint https://www.navpit.com/api/billing/webhook (affiché une fois par stripe:setup)
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com → API Keys). Secret, côté serveur.
RESEND_API_KEY=
EMAIL_FROM=Navpit <bonjour@navpit.com>

# Webhook Stripe alternatif (Edge Function Supabase, optionnel)
# supabase secrets set STRIPE_SECRET_KEY=… STRIPE_WEBHOOK_SECRET=… RESEND_API_KEY=… APP_URL=https://www.navpit.com
