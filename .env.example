# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier ".env" ne doit JAMAIS être envoyé sur GitHub (il est déjà ignoré par .gitignore).

# --- Base de données (Phase 1) ---
#
# Où trouver les URLs : Supabase → Project Settings → Database → Connection string
#
# ⚠️  NE PAS utiliser db.<ref>.supabase.co (connexion directe) :
#     Supabase ne la sert plus en IPv4 → erreur P1001 « Can't reach database server »
#     depuis la plupart des réseaux locaux et depuis Vercel.
#
# DATABASE_URL — requêtes applicatives (dev + Vercel) :
#   Mode « Transaction » du pooler Supabase, port 6543, suffixe ?pgbouncer=true
#   Hôte typique : aws-0-eu-west-1.pooler.supabase.com (varie selon la région)
#   connect_timeout=30 : le pooler met parfois 10–15 s à ouvrir une connexion à froid.
#   connection_limit=1 : Prisma n'ouvre qu'une connexion vers Supavisor (obligatoire
#   en serverless / plan gratuit — sinon « Timed out fetching from connection pool »).
#   pool_timeout=60 : attendre plus longtemps qu'une connexion se libère (Supabase lent à froid).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30&connection_limit=1&pool_timeout=60"
#
# DIRECT_URL — migrations Prisma uniquement (prisma migrate dev / deploy) :
#   Mode « Session » du pooler Supabase, port 5432, SANS ?pgbouncer=true
#   Même hôte pooler que DATABASE_URL, utilisateur postgres.[ref]
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?connect_timeout=30&connection_limit=1"

# --- Authentification Auth.js — email + mot de passe (Credentials), + Google (Phase 1) ---
# Clé secrète aléatoire, générée avec: npx auth secret
AUTH_SECRET=""
# Adresse canonique de l'application.
# Local : http://localhost:3000
# Production Vercel : https://app.tarineo.com (obligatoire pour OAuth Google / PKCE)
AUTH_URL="http://localhost:3000"

# --- Connexion Google, en plus du mot de passe (Phase 1) ---
# À créer dans Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# URI de redirection autorisée à configurer côté Google : {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Resend — plus utilisé pour la connexion (remplacée par mot de passe le 2026-08-30),
# conservé pour l'email de réinitialisation de mot de passe et les demandes du palier
# Entreprise (formulaire de contact sur la landing page) ---
RESEND_API_KEY=""
# Après vérification du domaine sur resend.com/domains (DKIM + SPF send/rsend)
EMAIL_FROM="Tarineo <contact@tarineo.com>"
# Import document par e-mail (webhook Resend inbound, événement email.received)
RESEND_INBOUND_DOMAIN="import.tarineo.com"
# Signing secret du webhook Resend (whsec_… depuis resend.com/webhooks) — pas un secret inventé.
RESEND_INBOUND_WEBHOOK_SECRET=""
# Cron relances (essai, hausses) — GET /api/cron/relances avec Authorization: Bearer <secret>
CRON_SECRET=""
# Cron export comptable auto — GET /api/cron/export-comptable (1er du mois)
# Pennylane OAuth — enregistrer l'app auprès de Pennylane Partnerships
PENNYLANE_CLIENT_ID=""
PENNYLANE_CLIENT_SECRET=""
# Monitoring erreurs (optionnel)
SENTRY_DSN=""
# Adresse recevant les demandes du palier Entreprise (voir PricingSection.tsx)
CONTACT_ENTREPRISE_EMAIL=""

# --- IA Claude pour l'extraction des devis/factures (Phase 2) ---
ANTHROPIC_API_KEY=""

# --- Stockage des fichiers — Supabase Storage (Phase 2) ---
# ⚠️  La connexion Tarineo n'utilise PAS Supabase Auth (auth.users / magic link du dashboard).
#     Seuls comptent les utilisateurs créés via /inscription ou Google (table Prisma User).
# URL et clé de service depuis le dashboard Supabase : Project Settings > API
# ATTENTION : SUPABASE_SERVICE_ROLE_KEY donne un accès complet, ne JAMAIS l'exposer côté client
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# --- Stripe — abonnements (Phase 4) ---
# Local : stripe listen --forward-to localhost:3000/api/stripe/webhook
# Prod : npx tsx scripts/configurer-webhook-stripe.ts --write-env
#        puis node scripts/sync-vercel-env.mjs
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price Stripe — créer en une commande (mode test ou live) :
#   STRIPE_SECRET_KEY=sk_test_… npx tsx scripts/creer-prix-stripe.ts --write-env
#   npx tsx scripts/mettre-a-jour-cle-publique-stripe.ts   # pk_test depuis Stripe CLI
# Voir stripe-billing-context.md pour le détail des plans (17/29/49 € mensuel).
# Price IDs — mode test (sk_test_) ou live (sk_live_) selon STRIPE_SECRET_KEY.
# En live, les 6 variables sont obligatoires (sinon checkout bloqué avec message FR).
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_STARTER_ANNUEL=""
STRIPE_PRICE_PRO_ANNUEL=""
STRIPE_PRICE_PREMIUM_ANNUEL=""
