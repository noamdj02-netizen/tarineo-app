{
  "name": "tarineo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:fresh": "prisma generate && rm -rf .next && next dev -H 0.0.0.0",
    "dev:webpack": "next dev -H 0.0.0.0 --webpack",
    "build": "next build --webpack",
    "vercel-build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "npx tsx prisma/seed.ts",
    "figma:capture": "node scripts/capture-dashboard-playwright.mjs",
    "figma:capture:mobile": "node scripts/capture-dashboard-playwright.mjs --mobile",
    "figma:capture:all": "node scripts/capture-dashboard-playwright.mjs --both",
    "figma:capture:prod": "CAPTURE_BASE=https://app.tarineo.com node scripts/capture-dashboard-playwright.mjs",
    "figma:capture:prod:mobile": "CAPTURE_BASE=https://app.tarineo.com node scripts/capture-dashboard-playwright.mjs --mobile",
    "stripe:webhook": "npx tsx scripts/configurer-webhook-stripe.ts",
    "stripe:webhook:prod": "npx tsx scripts/configurer-webhook-stripe.ts --write-env",
    "video:studio": "cd remotion && npm run studio",
    "video:render": "cd remotion && npm run render"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.2",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.18.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.52.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
