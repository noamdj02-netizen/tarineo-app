{
  "name": "navpit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbopack",
    "dev:webpack": "NEXT_DIST_DIR=.next-dev next dev",
    "dev:clean": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev --turbopack",
    "cleanup:dupes": "node scripts/remove-finder-duplicates.mjs",
    "cleanup:dupes:dry": "node scripts/remove-finder-duplicates.mjs --dry-run",
    "dev:turbo": "NEXT_DIST_DIR=.next-dev next dev --turbopack",
    "build": "next build",
    "build:turbo": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-force-exit 'lib/**/*.test.ts'",
    "test:security": "tsx --test --test-force-exit lib/site/landing-demo-rate-limit.test.ts lib/assistant/pending-action.test.ts lib/security/isolation-ab.test.ts lib/metier/list-documents-query.test.ts lib/billing/entitlements.test.ts lib/automation/margin.test.ts",
    "test:isolation:live": "tsx --env-file=.env.local scripts/rls-isolation-ab.ts",
    "postinstall": "node scripts/patch-react-pdf-hyphenate.mjs",
    "seed": "tsx scripts/seed.ts",
    "seed:plateau": "tsx --env-file=.env.local scripts/seed-tarineo-plateau.ts",
    "film:captures": "node scripts/film-captures.mjs",
    "pdf:fixture": "tsx scripts/generate-fixture-pdf.ts",
    "figma:capture": "node scripts/figma-dashboard-captures.mjs",
    "figma:go": "PORT=3000 node scripts/figma-dashboard-captures.mjs /accueil",
    "figma:go:mobile": "PORT=3000 node scripts/figma-dashboard-captures.mjs --mobile /accueil",
    "sync:landing": "node scripts/sync-landing-v2-from-export.mjs \"$HOME/Downloads/tarineo.zip\"",
    "design-data": "node scripts/build-design-data.mjs",
    "icons": "node scripts/build-icons.mjs",
    "email:auth": "node scripts/auth-emails.mjs",
    "email:send-all": "tsx --env-file=.env.local scripts/send-test-emails.ts",
    "stripe:setup": "node --env-file=.env.local scripts/stripe-setup.mjs",
    "remotion": "remotion studio remotion/index.ts --port 3333",
    "remotion:studio": "npm run remotion",
    "remotion:render": "remotion render remotion/index.ts TarineoTemplate-4K out/tarineo-template-4k.mp4",
    "remotion:render-1080": "remotion render remotion/index.ts TarineoTemplate out/tarineo-template-1080.mp4",
    "remotion:render-product": "remotion render remotion/index.ts TarineoProductV2 out/tarineo-product-v2.mp4",
    "remotion:render-compare": "remotion render remotion/index.ts TarineoCompareShowreel out/tarineo-compare-showreel.mp4",
    "remotion:zip": "node scripts/pack-remotion-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@base-ui/react": "^1.8.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@modelcontextprotocol/server": "^2.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-email/tailwind": "^1.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.4.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "mcp-handler": "^2.2.0",
    "next": "15.5.26",
    "node-ical": "^0.27.2",
    "playwright-core": "^1.63.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@remotion/captions": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "remotion": "4.0.532",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "overrides": {
    "mermaid": "11.13.0"
  }
}
