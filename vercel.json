{
  "crons": [
    {
      "path": "/api/cron/follow-ups",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/cron/accounting-exports",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "navpit.com" }],
      "destination": "https://www.navpit.com/:path*",
      "permanent": true
    }
  ]
}
